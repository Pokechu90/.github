# Copy this file to ".env" and fill in ONE provider. The .env file stays on
# your computer (it is git-ignored) and is only read by the server, never the
# browser.

# Which LLM gives the NPCs their voices: anthropic | openai | ollama
LLM_PROVIDER=anthropic

# --- Claude (Anthropic) ---  get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Default is Claude Opus 5.5. For lower cost per conversation you could use
# claude-sonnet-5-5 or claude-haiku-5-5 instead.
CLAUDE_MODEL=claude-opus-5-5

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Ollama (free, runs on your own computer: https://ollama.com) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Hard cap on LLM requests per minute (the in-game setting can go lower).
MAX_LLM_CALLS_PER_MINUTE=20

# Port for this server. The game finds it automatically when you use "npm run dev".
PORT=8787

# Only needed if you host the game somewhere else (e.g. GitHub Pages) and
# want it to talk to this server: the game's origin, e.g. https://you.github.io
ALLOWED_ORIGIN=
