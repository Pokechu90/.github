{
  "name": "worldsim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A living, procedurally generated world simulation that runs in the browser.",
  "scripts": {
    "dev": "concurrently -k -n game,brain -c cyan,magenta \"vite\" \"npm:server\"",
    "game": "vite",
    "server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "express": "^5.3.0",
    "pixi.js": "^8.22.0",
    "simplex-noise": "^4.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
