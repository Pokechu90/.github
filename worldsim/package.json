{
  "name": "worldsim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A living, procedurally generated world simulation that runs in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "simplex-noise": "^4.0.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
